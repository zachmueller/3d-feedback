{
  "name": "threed-host-cdk",
  "version": "0.1.0",
  "description": "Serverless host for sharing 3D models (GLB) with per-project revisions and public feedback",
  "bin": {
    "threed-host": "bin/threed-host.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:freecad": "\"${FREECADCMD:-$(command -v freecadcmd || echo /Applications/FreeCAD.app/Contents/Resources/bin/freecadcmd)}\" tools/freecad_selftest.py",
    "cdk": "cdk",
    "synth": "cdk synth",
    "vendor": "node scripts/vendor-three.js",
    "postinstall": "node scripts/vendor-three.js",
    "dev": "node scripts/serve-local.js",
    "sample-glb": "node scripts/make-sample-glb.js",
    "mcp": "ts-node --prefer-ts-exts --project tools/mcp/tsconfig.json tools/mcp/server.ts",
    "mcp:check": "tsc -p tools/mcp/tsconfig.json",
    "mcp:smoke": "node scripts/mcp-smoke.js"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "^3.658.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.6.4",
    "aws-cdk": "^2.1145.0",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-sts": "^3.1120.0",
    "@aws-sdk/credential-providers": "^3.1120.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.3",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.3.0",
    "three": "^0.169.0",
    "zod": "^3.25.76"
  }
}
