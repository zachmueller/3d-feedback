*.js
!jest.config.js
!scripts/*.js
!admin-app/**/*.js
!viewer-app/**/*.js
# CloudFront Function sources are hand-written .js, not build output.
!lib/cloudfront-functions/*.js
*.d.ts
node_modules

# three.js is copied out of node_modules by scripts/vendor-three.js (postinstall).
viewer-app/vendor/

# CDK asset staging directory
.cdk.staging

# freecad_selftest.py imports the exporter, which leaves bytecode behind.
__pycache__/
cdk.out

# The manual-setup checklist is a working document with account details in it.
MANUAL-SETUP.md

# Local env / secrets
.env
cdk.context.json
config.local.json
cdk-outputs.json
# MCP server settings for this machine; config.example.json is the committed one.
tools/mcp/config.json

# OS / editor
.DS_Store
*.log

private/
